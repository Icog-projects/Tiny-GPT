# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# PyTorch checkpoints and model weights (prevent committing multi-megabyte binaries)
checkpoints/*.pt
checkpoints/*.pth
checkpoints/*.bin
*.pt
*.pth
*.bin
!checkpoints/.gitkeep

# Datasets and local data caches (root level only)
/data/
*.arrow
*.parquet
.cache/
hf_cache/

# Logs and runtime artifacts (root level only)
/logs/
*.log

# Frontend (Node / Vite / React)
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files and secrets
.env
.env.local
.env.*.local

# Operating System & IDE artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
